{
	"display_information": {
		"name": "Crossroads Announcements",
		"description": "Posts Crossroads announcements with buttons, under the name of the person posting them.",
		"background_color": "#1f2a44"
	},
	"features": {
		"app_home": {
			"home_tab_enabled": false,
			"messages_tab_enabled": true,
			"messages_tab_read_only_enabled": true
		},
		"bot_user": {
			"display_name": "Crossroads Announcements",
			"always_online": false
		}
	},
	"oauth_config": {
		"scopes": {
			"user": ["chat:write"],
			"bot": ["chat:write", "chat:write.customize", "users:read", "reactions:read", "channels:read", "groups:read"]
		}
	},
	"settings": {
		"interactivity": {
			"is_enabled": true
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": true,
		"token_rotation_enabled": false
	}
}
