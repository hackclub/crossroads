# Postgres connection string. `docker compose up -d` starts one that matches this.
DATABASE_URL=postgres://crossroads:crossroads@localhost:5433/crossroads?sslmode=disable
PORT=8080

# From the Crossroads app on Hack Club Auth (auth.hackclub.com, developer mode).
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Has to match a redirect URI registered on the app. An https:// URL also makes
# cookies Secure, so use one everywhere but local development.
HCA_REDIRECT_URL=http://localhost:8080/auth/hcacallback

# Stamps paid per approved hour. The ticket should cost 60 times this (1,800 at 30).
STAMPS_PER_HOUR=30

# Copies approved submissions and shop orders into Airtable. Leave the token
# empty in development unless AIRTABLE_BASE_ID points at a test base: the real
# one is appuxTrbdZ2tjCo0X (YSWS - Crossroads). The token needs
# data.records:read and data.records:write on the base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Local development only. 1 adds /dev/login (sign in as a test user without
# Hack Club Auth) and fakes Hackatime so submissions can be tried. Anyone can
# sign in as anyone with it on, so it only starts with an http://localhost
# HCA_REDIRECT_URL, and never inside Kubernetes.
DEV_MODE=

# Where uploaded screenshots are stored (default data/uploads), and the site's
# public address, used to build their URLs (default: the origin of
# HCA_REDIRECT_URL). On a server, UPLOADS_DIR has to be on a disk that survives
# redeploys, or swap the storage for S3 / the Hack Club CDN.
UPLOADS_DIR=
PUBLIC_URL=

# Turns on POST /api/sidekick for Sidekick, Hack Club's review platform
# (planning/REVIEW_FLOW.md). Put the same secret in Sidekick. Leave it empty
# in development; dev mode ignores it anyway.
SIDEKICK_SECRET=

# Optional. An API key for gh-proxy.hackclub.com, Hack Club's pool of donated
# GitHub tokens (ask its admins for one). With it, GitHub requests go through
# the proxy, line counts turn on, and GITHUB_TOKEN isn't used.
GH_PROXY_API_KEY=

# Optional, without GH_PROXY_API_KEY. Any GitHub token (no scopes needed for
# public repos) raises GitHub's rate limit from 60 to 5,000 requests an hour,
# and turns on line counts on the review page. Without either, commit stats
# still work until the limit runs out.
GITHUB_TOKEN=

# Optional. A read-only Airtable token for the Unified YSWS DB, so reviews catch
# projects another program already paid for. Give it data.records:read on
# app3A5kJwYqxMLOgh and nothing else. Dev mode never uses it.
UNIFIED_AIRTABLE_TOKEN=

# Optional. A person's Telescreen profile, with {slack_id} where their Slack ID
# goes. Fraud reviewers get a link to it. Empty hides the link.
TELESCREEN_PROFILE_URL=
